<Window x:Class="EZsound.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EZsound.ViewModels"
        xmlns:conv="clr-namespace:EZsound.Converters"
        xmlns:views="clr-namespace:EZsound.Views"
        Title="EZsound Overlay"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="390"
        MinWidth="360" MaxWidth="440"
        MinHeight="200" MaxHeight="600"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="OverlayWindow_KeyDown"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:MuteToOpacityConverter x:Key="MuteToOpacity" />

        <!-- Application Card Style with Soft Hover -->
        <Style x:Key="OverlayAppCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Overlay Card with 97% opacity dark background and subtle glow -->
    <Border x:Name="RootBorder"
            CornerRadius="14"
            Background="#F712151C"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="3"
                              Opacity="0.75"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Master Audio Wave Visualizer -->
                <RowDefinition Height="Auto" /> <!-- Master Volume -->
                <RowDefinition Height="*" MaxHeight="430" /> <!-- Applications -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 HEADER (DRAGGABLE)
                 ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    CornerRadius="14,14,0,0"
                    Padding="14,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Logo -->
                        <ColumnDefinition Width="*" />    <!-- Title & Badge -->
                        <ColumnDefinition Width="Auto" /> <!-- Controls (Visualizer + Pin + Close) -->
                    </Grid.ColumnDefinitions>

                    <!-- Official Logo Badge -->
                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="6"
                            Background="{StaticResource SecondaryBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,10,0"
                            ClipToBounds="True">
                        <Image Source="pack://application:,,,/Resources/app.png"
                               Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <!-- Title & Hotkey Badge -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="EZsound"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />

                        <!-- Hotkey Keycap Tag -->
                        <Border Background="{StaticResource SecondaryBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding HotkeyText}"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource DimTextBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Header Controls: Visualizer + Pin + Close -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Toggle Wave Visualizer -->
                        <Button Style="{StaticResource PinButtonStyle}"
                                Content="&#xE995;"
                                ToolTip="Toggle Wave Visualizer"
                                Command="{Binding Main.ToggleVisualizerCommand}"
                                Margin="0,0,3,0" />

                        <!-- Pin (Always on top) -->
                        <Button Style="{StaticResource PinButtonStyle}"
                                Content="{Binding PinIcon}"
                                ToolTip="{Binding PinTooltip}"
                                Command="{Binding ToggleAlwaysOnTopCommand}"
                                Margin="0,0,3,0" />

                        <!-- Hide / Close Button -->
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Content="&#xE8BB;"
                                ToolTip="Hide Overlay (Esc)"
                                Command="{Binding HideCommand}"
                                Width="28" Height="28" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 MASTER AUDIO WAVE VISUALIZER
                 ═══════════════════════════════════════════════════════════ -->
            <views:MasterWaveVisualizer Grid.Row="1"
                                       CaptureService="{Binding Main.AudioCapture}"
                                       Visibility="{Binding Main.IsVisualizerEnabled, Converter={StaticResource BoolToVisibility}}"
                                       Margin="10,8,10,2" />

            <!-- ═══════════════════════════════════════════════════════════
                 MASTER VOLUME CARD
                 ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="10,6,10,4"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Speaker Icon Frame -->
                        <Border Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="6"
                                Background="{StaticResource SecondaryBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Margin="0,0,8,0">
                            <TextBlock Text="&#xE767;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{StaticResource AccentLightBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Column="1"
                                   Text="Master Volume"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />

                        <!-- Volume % Aligned Right -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Main.MasterVolume.VolumeText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Slider Grid.Column="0"
                                Style="{StaticResource MasterSliderStyle}"
                                Value="{Binding Main.MasterVolume.VolumePercent, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />

                        <Button Grid.Column="1"
                                Style="{StaticResource MuteButtonStyle}"
                                Command="{Binding Main.MasterVolume.ToggleMuteCommand}"
                                Width="28" Height="28"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Main.MasterVolume.MuteIcon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Main.MasterVolume.IsMuted}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 APPLICATIONS LIST
                 ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="10,6,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Subheader -->
                <Grid Grid.Row="0" Margin="2,0,2,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Applications"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <!-- Active Count Badge -->
                    <Border Grid.Column="1"
                            Background="{StaticResource SecondaryBackgroundBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,1">
                        <TextBlock FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource DimTextBrush}">
                            <Run Text="{Binding Main.SessionCount, Mode=OneWay}" />
                            <Run Text="active" />
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Scrollable list of sessions -->
                <ScrollViewer Grid.Row="1"
                              Style="{StaticResource ModernScrollViewer}"
                              MaxHeight="360"
                              Visibility="{Binding Main.HasSessions, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Main.Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AudioSessionViewModel}">
                                <Border Style="{StaticResource OverlayAppCardStyle}"
                                        Opacity="{Binding IsMuted, Converter={StaticResource MuteToOpacity}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header row: Icon, App Name, Percentage -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon -->
                                            <Border Grid.Column="0"
                                                    Width="26" Height="26"
                                                    CornerRadius="6"
                                                    Background="{StaticResource SecondaryBackgroundBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,8,0">
                                                <Image Source="{Binding Icon}"
                                                       Width="18" Height="18"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <!-- Name with ellipsis trimming -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="210" />

                                            <!-- Volume % Aligned Right -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding VolumeText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentLightBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Slider & Mute -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Slider Grid.Column="0"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Value="{Binding VolumePercent, Mode=TwoWay}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0" />

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource MuteButtonStyle}"
                                                    Command="{Binding ToggleMuteCommand}"
                                                    Width="28" Height="28"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MuteIcon}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <Border Grid.Row="1"
                        Visibility="{Binding Main.HasSessions, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7ED;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="32"
                                   Foreground="{StaticResource DimTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Opacity="0.7" />
                        <TextBlock Text="No active audio sessions"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource DimTextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
