<UserControl x:Class="EZsound.Views.MasterWaveVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="48"
             MinHeight="36"
             MaxHeight="60"
             ClipToBounds="True">
    <Grid>
        <!-- Background surface with rounded corners and subtle border -->
        <Border CornerRadius="10"
                Background="{StaticResource TopBarCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6"
                                  ShadowDepth="1"
                                  Opacity="0.15"
                                  Color="#000000" />
            </Border.Effect>
        </Border>

        <!-- Waveform / Equalizer Canvas for custom high-performance drawing -->
        <Border x:Name="WaveContainer"
                CornerRadius="9"
                ClipToBounds="True"
                Margin="1" />

        <!-- Minimal Status Indicator (non-intrusive) -->
        <Grid Margin="12,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mini Audio Pulse Dot -->
            <Ellipse Grid.Column="0"
                     x:Name="LiveIndicatorDot"
                     Width="5" Height="5"
                     Fill="{StaticResource AccentLightBrush}"
                     VerticalAlignment="Center">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="DotGlow"
                                      Color="{StaticResource AccentLightColor}"
                                      BlurRadius="5"
                                      ShadowDepth="0"
                                      Opacity="0.4" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- State Badge (Quiet / Level %) -->
            <TextBlock Grid.Column="2"
                       x:Name="LevelPercentText"
                       Text="CALM"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource DimTextBrush}"
                       Opacity="0.8"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
